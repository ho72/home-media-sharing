{
  "name": "ouri",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:server dev:web",
    "dev:server": "npm -w apps/server run dev",
    "dev:web": "npm -w apps/web run dev",
    "build": "npm -w apps/server run build && npm -w apps/web run build",
    "start": "npm -w apps/server run start",
    "db:migrate": "npm -w apps/server run db:migrate",
    "db:studio": "npm -w apps/server run db:studio",
    "seed": "npm -w apps/server run seed"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
