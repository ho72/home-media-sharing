{
  "name": "@app/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "seed": "dotenv -e ../../.env -- tsx src/lib/seed.ts",
    "retry-thumbs": "dotenv -e ../../.env -- tsx src/lib/retry-thumbs.ts",
    "regenerate-lg-thumbs": "dotenv -e ../../.env -- tsx src/lib/regenerate-lg-thumbs.ts",
    "generate-video-previews": "dotenv -e ../../.env -- tsx src/lib/generate-video-previews.ts"
  },
  "dependencies": {
    "@fastify/compress": "^7.0.3",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.18.0",
    "archiver": "^7.0.1",
    "exifr": "^7.1.3",
    "fastify": "^4.28.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.14.10",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.18.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
